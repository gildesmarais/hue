# Copy to .env (gitignored). hue-mcp reads this file itself, and Cursor also loads .env.
# Find the bridge: ./hue-mcp discover
# Then press the link button and create a username:
#   curl -X POST http://<BRIDGE_IP>/api -H "Content-Type: application/json" -d '{"devicetype":"hue#cursor"}'
HUE_BRIDGE_IP=
HUE_USERNAME=
